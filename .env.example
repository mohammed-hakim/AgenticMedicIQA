# Medical AgenticIQA environment template
# Copy to .env and fill in values. Never commit .env or real patient data.

# ---------------------------------------------------------------------------
# Project paths
# ---------------------------------------------------------------------------
AGENTIC_ROOT=/absolute/path/to/medical-agentic-iqa
AGENTIC_DATA_ROOT=${AGENTIC_ROOT}/data
AGENTIC_TOOL_HOME=${AGENTIC_ROOT}/iqa_tools
AGENTIC_LOG_ROOT=${AGENTIC_ROOT}/logs

# Cached PNGs rendered from DICOM/NIfTI inputs.
# Keep this on an encrypted local volume when working with clinical data.
AGENTIC_RENDER_CACHE=${AGENTIC_DATA_ROOT}/processed/render_cache

# ---------------------------------------------------------------------------
# VLM provider credentials (configure only the provider you use)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# For local, OpenAI-compatible inference, point OPENAI_BASE_URL at localhost:
# OPENAI_BASE_URL=http://localhost:8000/v1

# ---------------------------------------------------------------------------
# Privacy and logging notes
# ---------------------------------------------------------------------------
# The pipeline redacts file paths in its own logs and extracts only a small
# allow-list of non-identifying DICOM metadata. This is not a HIPAA/GDPR
# compliance guarantee. Burned-in PHI remains in pixels and external VLM calls
# transfer image data off-host. Use a local endpoint if that is not acceptable.

# Log level for scripts (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO
