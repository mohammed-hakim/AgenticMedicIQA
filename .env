# AgenticIQA Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control!

# ============================================================================
# Project Paths (Required)
# ============================================================================

# Project root directory (absolute path)
# AGENTIC_ROOT=D:/projects/work/immob/easy_agenticIQA
AGENTIC_ROOT=/content/AgenticMedicIQA

# Data directory (stores datasets, manifests, cache)
AGENTIC_DATA_ROOT=${AGENTIC_ROOT}/data

# IQA tools directory (model weights and metadata)
AGENTIC_TOOL_HOME=${AGENTIC_ROOT}/iqa_tools

# Logs directory (execution logs and traces)
AGENTIC_LOG_ROOT=${AGENTIC_ROOT}/logs


# ============================================================================
# API Keys (Optional - only needed if using cloud VLM APIs)
# ============================================================================

# OpenAI API (for GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=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

# Anthropic API (for Claude 3.5)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google API (for Gemini)
GOOGLE_API_KEY=AIzaSyD_5-EXMgyrxDAa9HWi0sciYViJhb19YTI


# ============================================================================
# Custom API Endpoints (Optional - for private deployments)
# ============================================================================

# OpenAI compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://musician-wrap-advocacy-campaigns.trycloudflare.com/v1

# Anthropic compatible endpoint
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google API endpoint
# GOOGLE_API_BASE_URL=


# ============================================================================
# Local Model Configuration (Optional - for local VLM inference)
# ============================================================================

# Path to Qwen2.5-VL model weights
# QWEN_MODEL_PATH=/path/to/qwen2.5-vl-7b-instruct


# ============================================================================
# LangGraph Configuration (Optional - for distributed state management)
# ============================================================================

# State storage backend (memory, redis, postgres)
# LANGGRAPH_STORAGE=memory

# Redis connection string (if using redis backend)
# LANGGRAPH_REDIS_URL=redis://localhost:6379/0

# PostgreSQL connection string (if using postgres backend)
# LANGGRAPH_POSTGRES_URL=postgresql://user:pass@localhost:5432/agenticiqa


# ============================================================================
# Development Settings (Optional)
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Enable debug mode
# DEBUG=false
